# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
APP_NAME=E-commerce ML Monitoring Service
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API Configuration
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8003

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# SQLite for development (simple, no setup needed)
DATABASE_URL=sqlite+aiosqlite:///./data/monitoring.db

# PostgreSQL for production (recommended for scale)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ml_monitoring

# ============================================================================
# STORAGE PATHS
# ============================================================================
REFERENCE_DATA_PATH=./data/reference
REPORTS_PATH=./data/reports
LOGS_PATH=./data/logs

# ============================================================================
# ML SERVICES URLS (Services being monitored)
# ============================================================================
SEARCH_SERVICE_URL=http://localhost:8000
SENTIMENT_SERVICE_URL=http://localhost:8002
COMMENTS_SERVICE_URL=http://localhost:8001
PRODUCTS_SERVICE_URL=http://localhost:8000

# ============================================================================
# MONITORING FEATURES (Enable/Disable different types of monitoring)
# ============================================================================
ENABLE_DRIFT_MONITORING=true              # Data drift detection with Evidently
ENABLE_PERFORMANCE_MONITORING=true        # Latency, throughput, errors
ENABLE_DATA_QUALITY_MONITORING=true       # Missing values, duplicates, etc.

# ============================================================================
# AUTOMATIC REPORT GENERATION (Cron format: minute hour day month weekday)
# ============================================================================
# Enable automatic report generation (requires scheduler)
AUTO_REPORTS_ENABLED=false                # Set to true to enable

# Drift Reports - Monitor data distribution changes
DRIFT_REPORT_CRON=0 */6 * * *            # Every 6 hours
DRIFT_REPORT_ENABLED=true

# Performance Reports - Monitor latency and errors
PERFORMANCE_REPORT_CRON=0 */1 * * *      # Every hour
PERFORMANCE_REPORT_ENABLED=true

# Daily Comprehensive Report - Full analysis once per day
DAILY_REPORT_CRON=0 9 * * *              # Every day at 9 AM
DAILY_REPORT_ENABLED=false

# Weekly Summary Report
WEEKLY_REPORT_CRON=0 10 * * 1            # Every Monday at 10 AM
WEEKLY_REPORT_ENABLED=false

# ============================================================================
# ALERT THRESHOLDS (When to trigger alerts)
# ============================================================================

# Data Drift Alert
DRIFT_THRESHOLD=0.3                       # Alert if >30% of features show drift
DRIFT_CRITICAL_THRESHOLD=0.5              # Critical alert if >50%

# Performance Alerts
LATENCY_THRESHOLD_MS=2000                 # Alert if p95 latency > 2 seconds
LATENCY_CRITICAL_MS=5000                  # Critical if > 5 seconds
ERROR_RATE_THRESHOLD=0.05                 # Alert if error rate > 5%
ERROR_RATE_CRITICAL=0.15                  # Critical if > 15%

# Sentiment Service Specific
CONFIDENCE_DROP_THRESHOLD=0.1             # Alert if confidence drops 10%
LOW_CONFIDENCE_THRESHOLD=0.6              # Alert if many predictions < 60%

# Search Service Specific
MIN_RESULTS_THRESHOLD=0                   # Alert if searches return 0 results
RELEVANCE_SCORE_THRESHOLD=0.5             # Alert if avg score drops below 0.5

# ============================================================================
# ALERT NOTIFICATION SETTINGS
# ============================================================================

# Alert Cooldown (prevent spam)
ALERT_COOLDOWN_MINUTES=30                 # Wait 30min before re-alerting same issue
MAX_ALERTS_PER_HOUR=10                    # Max alerts per hour

# Auto-resolve alerts
AUTO_RESOLVE_ALERTS=true                  # Auto-resolve when metrics normalize
AUTO_RESOLVE_AFTER_HOURS=24               # Auto-resolve after 24h if not updated

# ============================================================================
# EXTERNAL INTEGRATIONS
# ============================================================================

# Prometheus (Metrics export)
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_METRICS_PREFIX=ml_monitoring_

# InfluxDB (Time-series storage - optional)
INFLUXDB_ENABLED=false
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-token
INFLUXDB_ORG=ecommerce
INFLUXDB_BUCKET=ml_metrics
INFLUXDB_BATCH_SIZE=100

# S3/MinIO Storage (Cloud storage for reports - optional)
S3_ENABLED=false
S3_ENDPOINT=http://localhost:9000          # Use MinIO for local testing
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ml-reports
S3_REGION=us-east-1
S3_AUTO_UPLOAD_REPORTS=false               # Auto-upload HTML reports to S3

# Slack Alerts (Real-time notifications)
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#ml-alerts
SLACK_NOTIFY_DRIFT=true
SLACK_NOTIFY_PERFORMANCE=true
SLACK_NOTIFY_ERRORS_ONLY=false             # Only send errors, not warnings

# Email Alerts (optional)
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=monitoring@yourcompany.com
EMAIL_TO=team@yourcompany.com
EMAIL_DAILY_SUMMARY=true

# ============================================================================
# DATA RETENTION (Automatic cleanup)
# ============================================================================

# Prediction Logs
PREDICTION_LOG_RETENTION_DAYS=30          # Keep logs for 30 days
AUTO_CLEANUP_ENABLED=true                 # Enable automatic cleanup
CLEANUP_SCHEDULE_CRON=0 2 * * *          # Run cleanup at 2 AM daily

# Reports
REPORT_RETENTION_DAYS=90                  # Keep reports for 90 days
KEEP_CRITICAL_REPORTS=true                # Never delete reports with critical alerts

# Reference Data
REFERENCE_DATA_MAX_VERSIONS=5             # Keep last 5 versions
AUTO_UPDATE_REFERENCE=false               # Auto-update reference weekly
REFERENCE_UPDATE_CRON=0 3 * * 0          # Update every Sunday at 3 AM

# ============================================================================
# PERFORMANCE & OPTIMIZATION
# ============================================================================

# Batch Processing
BATCH_SIZE=1000                           # Process predictions in batches
MAX_EMBEDDING_SAMPLES=10000              # Limit embeddings for drift analysis

# Report Generation
REPORT_MAX_SAMPLES=50000                  # Max samples per report
REPORT_TIMEOUT_SECONDS=300                # 5 minutes timeout
PARALLEL_REPORT_GENERATION=false          # Generate reports in parallel

# Database
DB_POOL_SIZE=5                            # Connection pool size
DB_MAX_OVERFLOW=10                        # Max overflow connections
DB_ECHO=false                             # Log all SQL queries (debug only)

# Caching
ENABLE_CACHE=true                         # Cache report results
CACHE_TTL_SECONDS=3600                    # 1 hour cache

# ============================================================================
# ADVANCED MONITORING SETTINGS
# ============================================================================

# Drift Detection
DRIFT_METHOD=auto                         # auto, ks, psi, wasserstein
DRIFT_MIN_SAMPLES=100                     # Minimum samples needed for drift detection
DRIFT_REFERENCE_WINDOW_DAYS=7             # Use last 7 days as reference

# Outlier Detection
OUTLIER_DETECTION_ENABLED=true
OUTLIER_METHOD=isolation_forest           # isolation_forest, zscore, iqr
OUTLIER_CONTAMINATION=0.1                 # Expected outlier percentage

# Sampling (for high-volume scenarios)
SAMPLING_ENABLED=false                    # Enable sampling for logging
SAMPLING_RATE=0.1                        # Sample 10% of predictions
SAMPLING_ENSURE_DIVERSITY=true            # Ensure diverse samples

# ============================================================================
# FEATURE FLAGS (Experimental features)
# ============================================================================

ENABLE_MODEL_VERSIONING=false             # Track model versions
ENABLE_AB_TESTING=false                   # A/B testing support
ENABLE_COST_TRACKING=false                # Track inference costs
ENABLE_EXPLAINABILITY=false               # SHAP/LIME integration
ENABLE_FAIRNESS_METRICS=false             # Bias detection
